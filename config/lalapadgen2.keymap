#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };

        lt2: lt2 {
            compatible = "zmk,behavior-hold-tap";
            label = "layer_tap2";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            timeout-ms = <30>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <11 10>;
            timeout-ms = <30>;
        };

        COMBO_EQ_MINUS {
            bindings = <&mt EQUAL MINUS>;
            key-positions = <9 8>;
            timeout-ms = <30>;
        };

        NUMLOCK {
            bindings = <&kp KP_NUMLOCK>;
            key-positions = <35 36>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q              &kp W          &kp E              &kp R           &kp T                                        &kp Y             &kp U         &kp I          &kp O             &kp P
&kp A              &kp S          &kp D              &kp F           &kp G                                        &kp H             &kp J         &kp K          &kp L             &kp SEMICOLON
&mt2 LEFT_SHIFT Z  &kp X          &kp C              &kp V           &kp B                                        &kp N             &kp M         &kp COMMA      &kp PERIOD        &mt2 RIGHT_SHIFT SLASH
&kp LCTRL          &kp LWIN       &kp LEFT_ALT       &lt2 1 SPACE    &lt2 2 TAB        &lt2 3 ESC      &mkp LCLK  &lt2 2 BACKSPACE  &lt2 1 ENTER  &kp RIGHT_ALT  &kp SINGLE_QUOTE  &mt2 RCTRL BACKSLASH
                   &kp RA(GRAVE)  &kp RIGHT_BRACKET  &kp LANGUAGE_2  &kp LEFT_BRACKET  &kp LANGUAGE_1  &kp UP     &kp LEFT          &kp DOWN      &kp RIGHT      &trans
&mkp LCLK          &mkp RCLK      &mkp MCLK                                                                                                       &mkp LCLK      &mkp RCLK         &mkp MCLK
&mkp MB4           &mkp MB5       &kp LG(TAB)        &trans          &kp LCTRL                                    &mkp MB4          &mkp MB5      &kp LG(TAB)    &trans            &kp LCTRL
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp NUMBER_1      &kp NUMBER_2       &kp NUMBER_3  &kp NUMBER_4  &kp N5                   &kp KP_DIVIDE     &kp KP_MINUS       &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&kp NUMBER_6      &kp N7             &kp N8        &kp N9        &kp N0                   &kp KP_MULTIPLY   &kp KP_PLUS        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&kp F6            &kp F7             &kp F8        &kp F9        &kp F10                  &trans            &trans             &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&trans            &trans             &trans        &trans        &trans   &trans  &trans  &kp DEL           &trans             &kp KP_NUMBER_0  &kp KP_DOT       &mt2 RCTRL RS(SEMI)
                  &trans             &trans        &trans        &trans   &trans  &trans  &trans            &trans             &trans           &trans
&trans            &trans             &trans                                                                                    &trans           &trans           &trans
&kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans        &trans        &trans                   &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans           &trans           &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR            &kp PERCENT                               &kp PAGE_UP    &kp HOME  &kp UP_ARROW               &kp END    &kp UNDERSCORE
&kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                     &kp PAGE_DOWN  &kp LEFT  &kp DOWN_ARROW             &kp RIGHT  &trans
&trans           &kp GRAVE      &kp TILDE     &kp LEFT_BRACKET      &kp RIGHT_BRACKET                         &trans         &mkp MB4  &trans                     &mkp MB5   &mt2 RIGHT_SHIFT RS(SLASH)
&trans           &trans         &trans        &trans                &trans                 &trans  &mkp RCLK  &trans         &trans    &mt RIGHT_ALT PRINTSCREEN  &kp SLCK   &mt RIGHT_CONTROL PAUSE_BREAK
                 &trans         &trans        &trans                &trans                 &trans  &trans     &trans         &trans    &trans                     &trans
&trans           &trans         &trans                                                                                                 &trans                     &trans     &trans
&trans           &trans         &trans        &trans                &trans                                    &trans         &trans    &trans                     &trans     &trans
            >;
        };

        FUNCTION_LAYER {
            display-name = "function_layer";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &none   &none   &none   &none   &none
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                  &none   &none   &none   &none   &none
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &none   &none   &none   &none   &none
&trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans
         &trans   &trans   &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans   &trans                                                     &trans  &trans  &trans
&trans   &trans   &trans   &trans   &trans                   &trans  &trans  &trans  &trans  &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&none  &none  &none  &none  &none                         &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&none  &none  &none  &none  &none                         &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &none
&none  &none  &none  &none  &none                         &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&none  &none  &none  &none  &none  &none  &kp KP_NUMLOCK  &none                          &none                          &none                          &none                          &none
       &none  &none  &none  &none  &none  &none           &none                          &none                          &none                          &none
&none  &none  &none                                                                                                     &none                          &none                          &none
&none  &none  &none  &none  &none                         &none                          &none                          &none                          &none                          &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        system_layer {
            if-layers = <1 2 3>;
            then-layer = <4>;
        };
    };
};
